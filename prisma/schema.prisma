generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users ─────────────────────────

enum Role {
  ADMIN
  PROJECT_MANAGER
  ACCOUNTS
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(PROJECT_MANAGER)
  active       Boolean   @default(true)
  phone        String?
  designation  String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  opportunities Opportunity[] @relation("OpportunityOwner")
  projects      Project[]     @relation("ProjectManager")
  deliverables  Deliverable[] @relation("DeliverableOwner")
  documents     Document[]
  activities    Activity[]
  tasksAssigned ProposalTask[] @relation("TaskAssignee")
  tasksToReview ProposalTask[] @relation("TaskReviewer")
  tasksCreated  ProposalTask[] @relation("TaskCreator")
  taskComments  TaskComment[]
}

// ───────────────────────── Clients ─────────────────────────

enum ClientType {
  UN_AGENCY
  MULTILATERAL
  INTERNATIONAL_NGO
  GOVERNMENT
  PRIVATE
  NGO
  OTHER
}

model Client {
  id              String     @id @default(cuid())
  name            String
  shortName       String?
  type            ClientType @default(UN_AGENCY)
  country         String     @default("Switzerland")
  address         String?
  gstin           String?
  stateCode       String? // GST state code for Indian clients, e.g. "07"
  taxId           String? // foreign tax / vendor number
  vendorNumber    String? // our supplier number with this client
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  defaultCurrency String     @default("USD")
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  opportunities Opportunity[]
  projects      Project[]
  invoices      Invoice[]
}

// ───────────────────────── Pre-sales ─────────────────────────

enum OpportunityStatus {
  DRAFT
  IN_REVIEW
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_EVALUATION
  WON
  LOST
  CANCELLED
  NO_GO
}

model Opportunity {
  id                 String            @id @default(cuid())
  code               String            @unique
  title              String
  clientId           String
  client             Client            @relation(fields: [clientId], references: [id])
  status             OpportunityStatus @default(DRAFT)
  source             String? // UNGM, client email, website...
  referenceNo        String?
  currency           String            @default("USD")
  estimatedValue     Decimal?          @db.Decimal(16, 2) // value we quote / propose
  technicalWeight    Int? // e.g. 80 in an 80:20 QCBS
  financialWeight    Int?
  evaluationMethod   String?
  submissionDeadline DateTime?
  preBidDate         DateTime?
  queryDeadline      DateTime?
  durationMonths     Int?
  emdAmount          Decimal?          @db.Decimal(16, 2)
  scopeSummary       String?
  eligibility        String?
  requiredDocuments  String? // one per line
  notes              String?
  alertEmails        String? // comma separated
  ownerId            String?
  owner              User?             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  submittedAt        DateTime?
  decisionAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project   Project?
  documents Document[]
  tasks     ProposalTask[]
  sections  ProposalSection[]
  team      ProposalTeamMember[]
  refs      ProposalReference[]
  finLines  FinancialLine[]
  finTaxRate Decimal? @db.Decimal(5, 2) // tax % on the financial proposal (0 for LUT exports)
  finNotes   String?
}

// ───────────────────────── Delivery ─────────────────────────

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id            String        @id @default(cuid())
  code          String        @unique
  title         String
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  opportunityId String?       @unique
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])
  contractNo    String?
  contractDate  DateTime?
  contractValue Decimal       @default(0) @db.Decimal(16, 2)
  currency      String        @default("USD")
  startDate     DateTime?
  endDate       DateTime?
  status        ProjectStatus @default(ACTIVE)
  description   String?
  managerId     String?
  manager       User?         @relation("ProjectManager", fields: [managerId], references: [id])
  alertEmails   String? // comma separated
  reminderDays  String        @default("5,2,0") // days before due date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  deliverables Deliverable[]
  milestones   Milestone[]
  invoices     Invoice[]
  documents    Document[]
}

enum DeliverableType {
  DOCUMENT
  SYSTEM
  REPORT
  TRAINING
  DATA
  OTHER
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  REVISION
  ACCEPTED
}

model Deliverable {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq         Int               @default(1)
  title       String
  description String?
  type        DeliverableType   @default(DOCUMENT)
  status      DeliverableStatus @default(NOT_STARTED)
  dueDate     DateTime?
  ownerId     String?
  owner       User?             @relation("DeliverableOwner", fields: [ownerId], references: [id])
  alertEmails String? // extra recipients on top of the project's
  submittedAt DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  milestones Milestone[]
  documents  Document[]
}

// ───────────────────────── Finance ─────────────────────────

enum MilestoneStatus {
  PLANNED
  INVOICED
  PAID
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   Deliverable?    @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  title         String
  percent       Decimal?        @db.Decimal(6, 2)
  amount        Decimal         @db.Decimal(16, 2)
  dueDate       DateTime? // expected invoicing date
  status        MilestoneStatus @default(PLANNED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  invoices Invoice[]
}

enum SupplyType {
  EXPORT_LUT // export of services, zero-rated under LUT (no IGST)
  DOMESTIC_INTRA // CGST + SGST
  DOMESTIC_INTER // IGST
  EXEMPT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id])
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  milestoneId    String?
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  issueDate      DateTime
  dueDate        DateTime?
  currency       String
  exchangeRate   Decimal       @default(1) @db.Decimal(12, 4) // 1 unit of currency in INR
  supplyType     SupplyType
  placeOfSupply  String?
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  subtotal       Decimal       @db.Decimal(16, 2)
  cgst           Decimal       @default(0) @db.Decimal(16, 2)
  sgst           Decimal       @default(0) @db.Decimal(16, 2)
  igst           Decimal       @default(0) @db.Decimal(16, 2)
  total          Decimal       @db.Decimal(16, 2)
  status         InvoiceStatus @default(DRAFT)
  poReference    String?
  notes          String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  sac         String?
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(16, 2)
  amount      Decimal @db.Decimal(16, 2)
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date         DateTime
  amount       Decimal  @db.Decimal(16, 2) // amount received in bank (invoice currency)
  tds          Decimal  @default(0) @db.Decimal(16, 2) // tax deducted by client
  bankCharges  Decimal  @default(0) @db.Decimal(16, 2)
  exchangeRate Decimal  @default(1) @db.Decimal(12, 4) // realised INR rate
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())
}

// ───────────────────────── Shared ─────────────────────────

enum DocCategory {
  TOR
  RFP
  TECHNICAL_PROPOSAL
  FINANCIAL_PROPOSAL
  CONTRACT
  PURCHASE_ORDER
  DELIVERABLE
  INVOICE
  CORRESPONDENCE
  OTHER
}

model Document {
  id            String       @id @default(cuid())
  category      DocCategory  @default(OTHER)
  fileName      String
  storedName    String
  mimeType      String?
  size          Int
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  proposalTaskId String?
  proposalTask   ProposalTask? @relation(fields: [proposalTaskId], references: [id], onDelete: SetNull)
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime     @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model NotificationLog {
  id         String   @id @default(cuid())
  dedupeKey  String   @unique
  kind       String
  subject    String
  recipients String
  status     String // SENT | SKIPPED | FAILED
  error      String?
  createdAt  DateTime @default(now())
}

// ───────────────────────── AI intake (Phase 2) ─────────────────────────

enum ExtractionKind {
  TENDER // TOR / RFP → proposal
  CONTRACT // contract / PO → deliverables & payment schedule
}

/// One AI reading of one or more uploaded documents, kept for review & audit.
model AiExtraction {
  id            String         @id @default(cuid())
  kind          ExtractionKind
  status        String         @default("READY") // READY | APPLIED | DISCARDED
  result        Json
  documentIds   String[]
  provider      String
  model         String
  inputTokens   Int?
  outputTokens  Int?
  opportunityId String?
  projectId     String?
  createdById   String?
  createdAt     DateTime       @default(now())
  appliedAt     DateTime?
}

// ───────────────────────── Proposal team workflow ─────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

/// A part of a proposal (e.g. CVs, financial proposal) assigned to a team member and reviewed.
model ProposalTask {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        TaskStatus  @default(TODO)
  seq           Int         @default(0)
  dueDate       DateTime?
  assigneeId    String?
  assignee      User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reviewerId    String?
  reviewer      User?       @relation("TaskReviewer", fields: [reviewerId], references: [id])
  createdById   String?
  createdBy     User?       @relation("TaskCreator", fields: [createdById], references: [id])
  submittedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  comments  TaskComment[]
  documents Document[]

  @@index([assigneeId, status])
  @@index([reviewerId, status])
}

model TaskComment {
  id        String       @id @default(cuid())
  taskId    String
  task      ProposalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  kind      String       @default("COMMENT") // COMMENT | ASSIGNED | STARTED | SUBMITTED | APPROVED | CHANGES | REOPENED
  body      String?
  createdAt DateTime     @default(now())
}

// ───────────────────────── Proposal engine (Phase 3) ─────────────────────────

enum LibraryKind {
  PAST_PROPOSAL // past technical proposals used as examples for drafting
  FIN_TEMPLATE // past financial proposals / budget formats
  COMPANY_PROFILE // company profile, capability statements
  OTHER
}

/// Reusable documents: past proposals, company profile, templates. Text is extracted for AI drafting.
model LibraryItem {
  id           String      @id @default(cuid())
  kind         LibraryKind @default(PAST_PROPOSAL)
  title        String
  description  String?
  tags         String?
  fileName     String
  storedName   String
  mimeType     String?
  size         Int
  textContent  String?
  source       String? // "upload" | "templates-bank"
  uploadedById String?
  createdAt    DateTime    @default(now())
}

/// CV bank: staff and associate experts
model Expert {
  id              String   @id @default(cuid())
  name            String
  title           String?
  email           String?
  phone           String?
  nationality     String?
  yearsExperience Int?
  expertise       String? // comma separated tags
  languages       String?
  education       String?
  summary         String?
  keyProjects     String?
  dailyRate       Decimal? @db.Decimal(12, 2)
  rateCurrency    String   @default("USD")
  isStaff         Boolean  @default(false)
  active          Boolean  @default(true)
  cvFileName      String?
  cvStoredName    String?
  cvText          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  proposals ProposalTeamMember[]
  finLines  FinancialLine[]
}

/// Experience bank: past assignments used as references in proposals
model Reference {
  id          String   @id @default(cuid())
  title       String
  client      String
  country     String?
  startDate   DateTime?
  endDate     DateTime?
  value       Decimal? @db.Decimal(16, 2)
  currency    String   @default("USD")
  description String?
  services    String?
  projectId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposals ProposalReference[]
}

model ProposalSection {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  seq           Int         @default(0)
  title         String
  guidance      String? // what this section must cover (from TOR / evaluation criteria)
  content       String      @default("")
  aiModel       String? // set when the last draft came from AI
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ProposalTeamMember {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  expertId      String
  expert        Expert      @relation(fields: [expertId], references: [id], onDelete: Cascade)
  position      String
  isKey         Boolean     @default(true)
  inputDays     Decimal?    @db.Decimal(8, 1)
  seq           Int         @default(0)

  @@unique([opportunityId, expertId, position])
}

model ProposalReference {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  referenceId   String
  reference     Reference   @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  seq           Int         @default(0)

  @@id([opportunityId, referenceId])
}

enum CostCategory {
  FEES
  TRAVEL
  PER_DIEM
  OTHER
}

model FinancialLine {
  id            String       @id @default(cuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  seq           Int          @default(0)
  category      CostCategory @default(FEES)
  description   String
  expertId      String?
  expert        Expert?      @relation(fields: [expertId], references: [id], onDelete: SetNull)
  unit          String       @default("day")
  quantity      Decimal      @db.Decimal(12, 2)
  rate          Decimal      @db.Decimal(14, 2)
}
