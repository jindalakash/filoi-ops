# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/filoi_ops"
# openssl rand -hex 32
SESSION_SECRET=""
# openssl rand -hex 32  (encrypts SMTP password & AI keys in the DB — keep a backup; changing it makes saved keys unreadable)
ENCRYPTION_KEY=""
UPLOAD_DIR="./storage/uploads"
# Public URL used in reminder email links
APP_URL="http://localhost:3000"
# Set to 1 when served over HTTPS
COOKIE_SECURE="0"
# First admin (npm run db:seed)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@filoi.in"
ADMIN_PASSWORD=""
